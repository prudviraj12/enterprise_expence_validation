{
  "name": "enterprise-expense-platform",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web,ai \"npm:dev --workspace=@expense/api\" \"npm:dev --workspace=@expense/web\" \"npm:dev:ai\"",
    "dev:ai": "python -m uvicorn main:app --app-dir apps/ai-service --host 127.0.0.1 --port 8000 --reload",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
